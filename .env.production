# Production Environment Variables - Sahar Project

# API Configuration
VITE_API_URL=https://api.sahar.sa
VITE_API_KEY=your_production_api_key_here

# Database Configuration (for future migration to real database)
DATABASE_URL=postgresql://user:password@host:port/database
DATABASE_POOL_SIZE=10

# Authentication
VITE_JWT_SECRET=your_jwt_secret_here
VITE_JWT_EXPIRY=7d

# Cloud Storage (for future migration to cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Analytics
VITE_GA4_ID=G-XXXXXXXXXX
VITE_META_PIXEL_ID=your_meta_pixel_id
VITE_SNAP_PIXEL_ID=your_snap_pixel_id

# Site Configuration
VITE_SITE_URL=https://sahar.sa
VITE_SITE_NAME=سحر | SAHAR
VITE_DEFAULT_LOCALE=ar

# Payment Gateways
VITE_TABBY_API_KEY=your_tabby_api_key
VITE_TAMARA_API_KEY=your_tamara_api_key
VITE_STC_PAY_API_KEY=your_stc_pay_api_key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@sahar.sa

# SMS Configuration
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=Sahar

# Redis (for caching)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# CDN Configuration
CDN_URL=https://cdn.sahar.sa

# Feature Flags
ENABLE_ONYX_SYNC=true
ENABLE_AI_ASSISTANT=true
ENABLE_SKIN_ANALYZER=true
